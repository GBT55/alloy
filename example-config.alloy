// This config file is designed to send traces and metrics to the docker
// compose environment from example/docker-compose.

logging {
	level  = "debug"
	format = "logfmt"
}

discovery.consul "services" {
	server     = "consul-01.meigasplatform.work.eu-aws-02.nextgen.igrupobbva"
	tags       = ["metrics"]
	datacenter = "work-aws-spain-1"
	namespace  = "*"
	node_meta  = {
		network_segment = "default",
	}
	refresh_interval = "2m0s"
}
